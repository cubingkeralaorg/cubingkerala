{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-12",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "astro-app",
	"main": "./src/worker.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": ["0 2 * * *"]
	},
	"routes": [
		{ "pattern": "cubingkerala.com", "custom_domain": true },
		{ "pattern": "www.cubingkerala.com", "custom_domain": true }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cubingkerala",
			"database_id": "9bcda918-b80a-4790-b380-219a5594bf56",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "cubingkerala-media",
			"remote": true
		}
	],
	// Per-IP backstop against request bursts (free-plan Workers CPU limit is
	// fixed at ~10ms/request and can't be raised in code — this binding is
	// how we avoid tripping it: reject excess requests cheaply before they
	// reach D1 + SSR rendering, instead of letting the runtime kill them with
	// a 1102 "exceeded resource limits" error). Threshold is generous on
	// purpose — it only fires on sustained bursts (bots, load tests), not a
	// person clicking through pages at normal speed. See src/worker.ts.
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 100, "period": 60 }
		}
	]
}