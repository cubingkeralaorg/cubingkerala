---
// A slim top-of-page progress bar, shown site-wide via Layout.astro.
// Layout.astro's <ClientRouter /> turns internal link clicks into soft
// navigations (fetch + swap instead of a full document reload), which is
// instant enough most of the time that this bar is mostly invisible — it
// exists for the slower cases (a competition detail page's live WCA API
// calls, a cache-miss render). Vanilla JS, no framework: this needs to run
// on every page, including ones with no hydrated island at all, so it
// can't be a React component.
---

<div id="page-loading-bar" aria-hidden="true"></div>

<style>
  #page-loading-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    /* Animated via transform (not width) so it runs on the compositor
       instead of triggering layout on every frame. */
    width: 100%;
    transform: scaleX(0);
    transform-origin: left;
    background: var(--color-primary);
    z-index: 100;
    opacity: 0;
    transition:
      transform 400ms ease-out,
      opacity 150ms ease-out;
    pointer-events: none;
  }
  #page-loading-bar.is-loading {
    opacity: 1;
  }
</style>

<script is:inline>
  (function () {
    var bar = document.getElementById("page-loading-bar");
    if (!bar) return;
    var hideTimer;

    function show(target) {
      clearTimeout(hideTimer);
      bar.classList.add("is-loading");
      // Force a reflow so the transform transition animates from the current
      // value instead of jumping straight to `target`.
      void bar.offsetWidth;
      bar.style.transform = "scaleX(" + target / 100 + ")";
    }

    function hide() {
      bar.style.transform = "scaleX(1)";
      hideTimer = setTimeout(function () {
        bar.classList.remove("is-loading");
        bar.style.transform = "scaleX(0)";
      }, 200);
    }

    // Covers this page's own remaining load time on the very first,
    // real browser navigation (scripts/images/island hydration still in
    // flight after the HTML itself arrived) — astro:page-load below
    // covers the "now it's ready" half of this same moment.
    if (document.readyState !== "complete") {
      show(80);
    }

    // <ClientRouter /> (Layout.astro) owns same-origin link clicks now —
    // not this script. It already skips a click to the page you're
    // already on (no-op, no reload), aborts a superseded in-flight
    // navigation the instant a newer click supersedes it, and leaves
    // cross-origin / download / data-astro-reload links to a normal full
    // browser navigation this script doesn't need to touch. So this just
    // observes the router's own lifecycle events instead of intercepting
    // clicks itself — doing both would mean two click listeners racing to
    // call preventDefault() on the same event.
    document.addEventListener("astro:before-preparation", function () {
      show(80);
    });
    document.addEventListener("astro:page-load", function () {
      hide();
    });

    // Back/forward restores from bfcache should never show a stuck bar.
    window.addEventListener("pageshow", function (event) {
      if (event.persisted) hide();
    });
  })();
</script>
