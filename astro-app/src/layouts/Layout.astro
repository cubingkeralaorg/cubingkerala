---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { Navbar } from "@/components/layout/navbar";
import { Footer } from "@/components/layout/footer";
import PageLoadingBar from "@/components/layout/page-loading-bar.astro";
import { Toaster } from "sonner";
import { isAdminAccount } from "@/config/admin";
import { env } from "cloudflare:workers";
import { getDb } from "@/db/client";
import { getMemberByWcaid } from "@/db/queries/members";
import { getUserProfileFields } from "@/db/queries/users";

interface Props {
  title?: string;
  description?: string;
  footerTopPaddingClassName?: string;
}

// Ported from the old Next.js app's root layout.tsx metadata — it had a
// description (SEO) that astro-app never carried over. Each page passes its
// own via this prop (matching the old app's per-page `metadata.description`
// exports); this default is the old app's root/homepage one.
const {
  title = "Cubing Kerala",
  description = "Cubing Kerala is the official website for the Rubik's Cube community in Kerala, providing resources, event updates, and a platform for enthusiasts to connect.",
  footerTopPaddingClassName,
} = Astro.props;

const currentPath = Astro.url.pathname;

// Canonical is always the bare (no-www) domain — middleware.ts redirects
// www there already, this is the same canonical choice reflected in the
// page's own <head>. Built from the path, not Astro.url directly, so a
// request that somehow reaches here on a different host still declares
// the one real canonical origin.
const SITE_ORIGIN = "https://cubingkerala.com";
const canonicalUrl = `${SITE_ORIGIN}${currentPath}`;
const ogImageUrl = `${SITE_ORIGIN}/og-image.png`;

// Same cookie, same check the middleware uses for /requests — computed here
// too so the Requests nav link (and the footer's EmailControl) can be
// server-rendered correctly on first paint instead of popping in after
// client-side JS runs.
const userCookie = Astro.cookies.get("userInfo");
let isAdmin = false;
let isLoggedIn = false;
let initialProfile: { isMember: boolean; email: string | null; emailConsent: boolean } | null = null;

if (userCookie) {
  try {
    const userData = JSON.parse(userCookie.value);
    isLoggedIn = true;
    isAdmin = isAdminAccount(userData.me);

    const wcaid = userData.me?.wca_id;
    if (wcaid) {
      const db = getDb(env.DB);
      const [member, profileFields] = await Promise.all([
        getMemberByWcaid(db, wcaid),
        getUserProfileFields(db, wcaid),
      ]);
      initialProfile = {
        isMember: !!member,
        email: profileFields?.email ?? null,
        emailConsent: profileFields?.emailConsent ?? false,
      };
    }
  } catch {
    isAdmin = false;
    isLoggedIn = false;
  }
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Every internal <a> click becomes a soft navigation instead of a
        full document reload: fetches the new page, swaps it in, re-hydrates
        islands — no blank-page flash, no re-parsing every script/stylesheet
        from scratch, and clicking a link to the page you're already on is
        a no-op (Astro checks same pathname+search and skips re-fetching
        entirely) instead of reloading. Cross-origin links, downloads, and
        anything marked data-astro-reload fall through to a normal browser
        navigation untouched — needed for any link whose target immediately
        redirects off-site (e.g. to WCA's OAuth page), since this router
        can't meaningfully soft-navigate into a cross-origin redirect.
        src/components/layout/page-loading-bar.astro listens to this
        router's own lifecycle events rather than intercepting clicks
        itself, to avoid the two fighting over the same click.
        fallback="swap": an instant content swap for browsers without
        native View Transitions support, no simulated animation — paired
        with disabling the native cross-fade itself in global.css, so
        navigation is a plain, immediate swap everywhere rather than a
        transition effect. */}
    <ClientRouter fallback="swap" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/cubingkerala_logo.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Cubing Kerala" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SportsOrganization",
      name: "Cubing Kerala",
      url: SITE_ORIGIN,
      logo: `${SITE_ORIGIN}/cubingkerala_logo_email.png`,
      description,
      sameAs: [
        "https://www.instagram.com/cubingkerala",
        "https://www.facebook.com/cubingkeralaofficial",
      ],
    })} />
    {/* Runs before first paint so there's no flash of the wrong theme —
        useTheme (client-side) stays in sync with the same localStorage key.

        <ClientRouter />'s swap wipes every attribute on <html> (including
        this script's own "dark" class, which only ever exists as a
        runtime DOM mutation — it's never part of the server-rendered
        markup) and replaces them with the new page's. Two parts to fixing
        that, not one:
          1. astro:before-swap fires with the parsed-but-not-yet-applied
             new document — setting the class there BEFORE Astro copies
             its attributes onto the live <html> means the swap itself
             carries the correct class, so there's no gap where the new
             page is visible without it. This is the actual fix for the
             flash — on mobile especially, where the gap was long enough
             to be visibly jarring on bordered/backgrounded elements (the
             competitions search bar, the rankings event selector).
          2. data-astro-rerun (below) is the belt-and-suspenders fallback:
             without it, Astro treats an inline script with identical
             content as "already ran" and skips re-running it on a swap at
             all. Astro's own re-run mechanism fires via runScripts(),
             which happens AFTER the swap/paint — too late to prevent the
             flash by itself (that's what part 1 is for), but still
             correct as a fallback for anything part 1 missed. */}
    <script is:inline data-astro-rerun>
      function ckApplyTheme(root) {
        try {
          if (localStorage.getItem("ck_theme") !== "light") {
            root.classList.add("dark");
          } else {
            root.classList.remove("dark");
          }
        } catch {
          root.classList.add("dark");
        }
      }
      ckApplyTheme(document.documentElement);
      // This whole script re-runs on every swap (data-astro-rerun), which
      // would otherwise pile up a duplicate listener on every navigation —
      // guard so it's only ever attached once.
      if (!window.__ckThemeListenerAttached) {
        window.__ckThemeListenerAttached = true;
        document.addEventListener("astro:before-swap", function (event) {
          ckApplyTheme(event.newDocument.documentElement);
        });
      }
    </script>
    {/* Login/logout redirect to a "?__fresh=<timestamp>" URL (callback.ts,
        navbar.tsx) purely to force the browser past its own HTTP cache for
        "/" — see worker.ts's Cache-Control comments. It has no other
        meaning, so strip it from the address bar right away rather than
        leave a stray param a user might bookmark or share. replaceState,
        not a real navigation — doesn't re-trigger a fetch or reload. */}
    <script is:inline>
      try {
        const url = new URL(window.location.href);
        if (url.searchParams.has("__fresh")) {
          url.searchParams.delete("__fresh");
          window.history.replaceState(null, "", url.pathname + url.search + url.hash);
        }
      } catch {}
    </script>
  </head>
  <body class="flex min-h-dvh flex-col bg-background font-sans antialiased">
    <PageLoadingBar />
    <Navbar client:load currentPath={currentPath} isAdmin={isAdmin} isLoggedIn={isLoggedIn} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer
      client:load
      topPaddingClassName={footerTopPaddingClassName}
      isLoggedIn={isLoggedIn}
      initialProfile={initialProfile}
    />
    <Toaster client:load richColors position="bottom-right" />
  </body>
</html>
