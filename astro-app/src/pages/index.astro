---
import Layout from "@/layouts/Layout.astro";
import HeroSection from "@/components/home/hero-section";
import { HeroPhotoMarquee } from "@/components/home/photo-strip-section";
import { UpcomingCompetitionsSection, PastCompetitionsSection } from "@/components/home/competitions-preview-section";
import { HighlightVideoSection } from "@/components/home/highlight-video-section";
import { AchievementBanner } from "@/components/home/achievement-banner";
import { RankingsPreviewSection } from "@/components/home/rankings-preview-section";
import { MembersPreviewSection } from "@/components/home/members-preview-section";
import { CommunityBannerSection } from "@/components/home/community-banner-section";
import { NAVBAR_CONTAINER_CLASS } from "@/components/layout/navbar/layout";
import { env } from "cloudflare:workers";
import { getDb } from "@/db/client";
import { getUpcomingCompetitions, getPastCompetitions } from "@/db/queries/competitions";
import { getAllMembers, getWcaSummaryForMembers, getRankingsWcaDataForMembers } from "@/db/queries/members";
import { getAllPhotos } from "@/db/queries/photos";
import { mediaUrl } from "@/config/media";

// D1-backed queries (Phase 4) — bindings come from `cloudflare:workers`,
// not Astro.locals.runtime.env (removed in this @astrojs/cloudflare
// version). See src/env.d.ts.
const db = getDb(env.DB);
const [upcoming, allPast, members, photos] = await Promise.all([
  getUpcomingCompetitions(db),
  getPastCompetitions(db),
  getAllMembers(db),
  getAllPhotos(db),
]);
// getPastCompetitions returns every past competition (correct for the full
// /competitions page, which also reads it) — this is just a homepage
// preview with a "View all competitions" link below it, so cap it at the
// 10 most recent (already sorted desc by start_date) instead of dumping
// the entire history here.
const past = allPast.slice(0, 10);
const memberWcaIds = members.map((member) => member.wcaid);
const [wcaSummaries, rankingsWcaData] = await Promise.all([
  getWcaSummaryForMembers(db, memberWcaIds),
  getRankingsWcaDataForMembers(db, memberWcaIds),
]);

// Alternate by insertion order into two rows so a newly admin-added photo
// always lands in whichever row has fewer, keeping the marquee balanced.
const photoRow1 = photos.filter((_, index) => index % 2 === 0).map((p) => ({ src: mediaUrl(p.path), alt: p.alt }));
const photoRow2 = photos.filter((_, index) => index % 2 === 1).map((p) => ({ src: mediaUrl(p.path), alt: p.alt }));
---

<Layout
  title="Cubing Kerala | Rubik's Cube Community & Competitions"
  footerTopPaddingClassName="pt-10"
>
  {/* Hero + photo marquee fill the first screen (viewport minus the 64px
      sticky navbar), centered as one cohesive block with a fixed gap
      between them — not justify-between, which stretched that gap to
      absorb all the leftover space on taller screens and pushed the
      photos too far down, away from the hero text above them. The marquee
      is pure CSS (no client directive) — nothing to hydrate. */}
  <div class="flex min-h-[calc(90dvh-4rem)] flex-col justify-center gap-12">
    <HeroSection />
    <HeroPhotoMarquee row1={photoRow1} row2={photoRow2} />
  </div>

  <div class="my-28">
    <HighlightVideoSection client:load />
  </div>

  {/* Full tables now (no clipping), so they get the same wide container
      the real /competitions, /rankings, and /members pages use. */}
  <div class={`${NAVBAR_CONTAINER_CLASS} flex flex-col gap-28 pb-28`}>
    <UpcomingCompetitionsSection client:visible upcoming={upcoming} />
    <PastCompetitionsSection client:visible past={past} />
    <AchievementBanner client:load />
    <RankingsPreviewSection client:load members={members} rankingsWcaData={rankingsWcaData} />
    <MembersPreviewSection members={members} wcaSummaries={wcaSummaries} />
  </div>

  <CommunityBannerSection />
</Layout>
