---
import Layout from "@/layouts/Layout.astro";
import CompetitionsPage from "@/components/competitions/competitions-page";
import { RefreshButton } from "@/components/competitions/refresh-button";
import { NAVBAR_CONTAINER_CLASS } from "@/components/layout/navbar/layout";
import { env } from "cloudflare:workers";
import { getDb } from "@/db/client";
import { getUpcomingCompetitions, getPastCompetitions } from "@/db/queries/competitions";
import { getSystemMetadataValue } from "@/db/queries/system-metadata";

const db = getDb(env.DB);
const [upcoming, past, lastSyncValue] = await Promise.all([
  getUpcomingCompetitions(db),
  getPastCompetitions(db),
  getSystemMetadataValue(db, "last_competition_sync"),
]);
const lastUpdated = lastSyncValue
  ? new Date(lastSyncValue).toLocaleString("en-US", { hour: "2-digit", minute: "2-digit" })
  : "";
---

<Layout
  title="Competitions | Cubing Kerala"
  description="Upcoming and past competitions of Rubik's Cube community in Kerala"
>
  <div class={`${NAVBAR_CONTAINER_CLASS} py-6 sm:py-10`}>
    <div class="mb-4 flex flex-col items-start gap-4 sm:mb-6 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex w-full min-w-0 flex-col gap-2 sm:w-auto sm:flex-1">
        <h1 class="text-4xl font-semibold tracking-tight md:text-5xl">Competitions</h1>
        <p class="w-full text-sm text-muted-foreground md:text-base lg:whitespace-nowrap">
          {lastUpdated ? `Last updated: ${lastUpdated}` : "Upcoming and past competitions of the Rubik's Cube community in Kerala."}
        </p>
      </div>
      <RefreshButton client:load />
    </div>
    <CompetitionsPage client:load upcoming={upcoming} past={past} />
  </div>
</Layout>
