---
import Layout from "@/layouts/Layout.astro";
import { CompetitionDetail } from "@/components/competitions/competition-detail";
import {
  mockUpcomingCompetitions,
  mockPastCompetitions,
  mockCompetitionDetails,
  mockCompetitionResults,
} from "@/lib/mock-data";

// Static for now (mock data, no DB) — every competition gets a prerendered
// page. Swapping to a real D1 query later turns this into an SSR route
// (`export const prerender = false`) with no change to the component below.
export function getStaticPaths() {
  const allCompetitions = [...mockUpcomingCompetitions, ...mockPastCompetitions];
  return allCompetitions.map((competition) => ({
    params: { id: competition.id },
    props: { competition },
  }));
}

const { competition } = Astro.props;
const detail = mockCompetitionDetails[competition.id];
const results = mockCompetitionResults[competition.id] ?? [];
---

<Layout title={`${competition.name} | Cubing Kerala`}>
  <CompetitionDetail competition={competition} detail={detail} results={results} />
</Layout>
