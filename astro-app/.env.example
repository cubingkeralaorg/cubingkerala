# Environment variables — Astro / Cloudflare Workers rewrite
# ============================================================
#
# Two separate systems here, now that Phase 5 (auth) actually built out
# both — don't mix them up:
#
# 1. Worker secrets/bindings (CLIENT_ID, CLIENT_SECRET, ADMIN_USER_ID,
#    ADMIN_WCA_ID, SKIP_WCA_LIVE_SYNC below) — read via
#    `import { env } from "cloudflare:workers"` in server code. Locally
#    these go in astro-app/.dev.vars (gitignored, NOT this file — see
#    AGENTS.md's secrets guardrail). In production: `wrangler secret put
#    <NAME>`.
# 2. Astro/Vite build-time PUBLIC_* vars (PUBLIC_WHATSAPP_CONTACT_URL) —
#    read via `import.meta.env.PUBLIC_*`. Not a secret, just a value that
#    can change without a code change. Locally these go in astro-app/.env
#    or .env.local (gitignored). In production: set as a build-time
#    environment variable wherever the build runs (e.g. CI), since Astro
#    inlines PUBLIC_* at build time, not request time.
#
# Do not commit `.env`, `.env.local`, or `.dev.vars` — this file is the only
# one that's meant to be committed, as a reference for what exists.
#
# Differences from the old Next.js app's root .env.example (see the plan
# doc's "Backend inventory" section for the full reasoning):
#   - DATABASE_URL / POSTGRES_URL_TEST are gone — D1 is a Cloudflare binding
#     (wrangler.jsonc), not a connection string.
#   - CRON_SECRET is gone — the sync job becomes a native Cloudflare Cron
#     Trigger, not a publicly reachable HTTP endpoint.
#   - NEXT_PUBLIC_BASE_URL is gone entirely, not just renamed — it was
#     confirmed unused in the old app too; the OAuth redirect URL is always
#     computed from the request's own origin (see src/pages/login.ts).
#   - SKIP_WCA_LIVE_SYNC is new here (it existed in the old app's code but
#     was missing from its .env.example — an oversight, fixed here).

# WCA OAuth (Worker secret)
CLIENT_ID="your-wca-client-id"
CLIENT_SECRET="your-wca-client-secret"

# Admin (Worker secret, server-only — never prefix with PUBLIC_)
# WCA website user id and/or WCA ID of the account that can open /requests
ADMIN_USER_ID="your-wca-numeric-user-id"
ADMIN_WCA_ID="YYYYXXXX99"

# WCA sync kill switch (Worker secret) — "true" skips all live WCA API
# fetches and serves only whatever's already cached in D1.
SKIP_WCA_LIVE_SYNC="false"

# WhatsApp (Astro PUBLIC_* build-time var)
PUBLIC_WHATSAPP_CONTACT_URL="https://wa.me/cubingkerala_cofounder_number"

# Media base URL (Astro PUBLIC_* build-time var) — the cubingkerala-media R2
# bucket's public URL (see src/config/media.ts). Currently the bucket's
# r2.dev public dev URL; switch to a real custom subdomain (e.g.
# media.cubingkerala.org) at Phase 10 cutover — r2.dev isn't meant for
# production traffic.
PUBLIC_MEDIA_BASE_URL="https://pub-f5a49e330f2443ed88ce6e6675c39d6c.r2.dev"
