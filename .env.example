# Environment variables
# =====================
#
# Copy this file to ONE local secrets file:
#
#   cp .env.example .env.local
#
# Next.js loads `.env.local` automatically.
# Prisma CLI does not — `npm run db:*` scripts load `.env.local` (then `.env`) for you.
#
# Do not commit `.env` or `.env.local`. You only need one of them locally.
# If both exist, Next.js uses `.env.local` over `.env`.
#
# Production: Vercel → Settings → Environment Variables
# CI: GitHub → Settings → Secrets and variables → Actions

# Database
DATABASE_URL="your-database-url"

# WCA OAuth
CLIENT_ID="your-wca-client-id"
CLIENT_SECRET="your-wca-client-secret"

# Application URL (required for OAuth redirects)
# Development: http://localhost:3000
# Production: https://www.cubingkerala.org
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# WhatsApp
NEXT_PUBLIC_WHATSAPP_CONTACT_URL="https://wa.me/cubingkerala_cofounder_number"

# Admin (server-only — do not prefix with NEXT_PUBLIC_)
# WCA website user id and/or WCA ID of the account that can open /requests
ADMIN_USER_ID="your-wca-numeric-user-id"
ADMIN_WCA_ID="YYYYXXXX99"

# Test database (CI)
POSTGRES_URL_TEST="postgresql://user:password@host.region.aws.neon.tech/testdb"
